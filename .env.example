# ===========================================
# APPLICATION
# ===========================================

NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

TRANSCRIPTION_ONLY_MODE=true
ENABLE_AI_QA=false

# ===========================================
# SUPABASE PUBLIC
# ===========================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# SUPABASE SERVER ONLY
# ===========================================

SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ===========================================
# STORAGE
# ===========================================

STORAGE_PROVIDER=supabase
SUPABASE_AUDIO_BUCKET=call-recordings

# ===========================================
# TRANSCRIPTION
# ===========================================

TRANSCRIPTION_PROVIDER=assemblyai
ENABLE_MOCK_TRANSCRIPTION=false

ASSEMBLYAI_API_KEY=your-assemblyai-api-key
ASSEMBLYAI_WEBHOOK_SECRET=your-assemblyai-webhook-secret
ASSEMBLYAI_WEBHOOK_URL=https://your-project.vercel.app/api/webhooks/assemblyai

# ===========================================
# OPTIONAL QA — CURRENTLY DISABLED
# ===========================================

OPENAI_API_KEY=
OPENAI_QA_MODEL=gpt-4o-mini
OPENAI_QA_PROMPT_VERSION=qa-audit-v1

# ===========================================
# APPLICATION LIMITS
# ===========================================

MAX_AUDIO_FILE_MB=50
